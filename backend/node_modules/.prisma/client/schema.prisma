datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String             @id @default(uuid())
  fullName         String
  mobile           String?            @unique
  email            String?            @unique
  passwordHash     String
  role             String             @default("trainee")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  profile          Profile?
  userSkills       UserSkill[]
  aiAnalyses       AiAnalysis[]
  employmentStatus EmploymentStatus[]
  notifications    Notification[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  education String?
  bio       String?
  district  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         String        @id @default(uuid())
  name       String        @unique
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  userSkills UserSkill[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  rating    Int
  user      User     @relation(fields: [userId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
}

model EmploymentStatus {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  status     String
  company    String?
  salary     Int?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiAnalysis {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  skillScore         Int
  employabilityScore Int
  strongSkills       String[]
  missingSkills      String[]
  recommendedPath    String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model District {
  id             String   @id @default(uuid())
  name           String   @unique
  employmentRate Int
  skillGap       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TrainingCenter {
  id        String   @id @default(uuid())
  name      String
  district  String
  capacity  Int
  enrolled  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(uuid())
  mobile    String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
